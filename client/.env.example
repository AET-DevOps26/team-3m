# Backend API base URL — empty uses Vite proxy in dev; set to the deployed origin in prod
VITE_API_BASE_URL=

# OIDC / Keycloak
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/kontor
VITE_OIDC_CLIENT_ID=kontor-spa
VITE_OIDC_AUDIENCE=kontor-api

# Grafana Faro (browser RUM) — Alloy faro.receiver /collect endpoint; empty disables
VITE_FARO_COLLECTOR_URL=
VITE_OTEL_SERVICE_NAME=kontor-client
VITE_DEPLOYMENT_ENVIRONMENT=local
