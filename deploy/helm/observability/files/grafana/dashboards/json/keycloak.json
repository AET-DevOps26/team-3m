{
  "uid": "kontor-keycloak",
  "title": "Kontor — Keycloak",
  "tags": ["kontor", "keycloak", "auth"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "deployment_environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(jvm_memory_used_bytes{service=\"keycloak\"}, deployment_environment)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{service=\"keycloak\", deployment_environment=~\"$deployment_environment\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP latency (avg / max)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "avg",
          "expr": "sum(rate(http_server_requests_seconds_sum{service=\"keycloak\", deployment_environment=~\"$deployment_environment\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{service=\"keycloak\", deployment_environment=~\"$deployment_environment\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "avg"
        },
        {
          "refId": "max",
          "expr": "max(http_server_requests_seconds_max{service=\"keycloak\", deployment_environment=~\"$deployment_environment\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM heap used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (jvm_memory_used_bytes{service=\"keycloak\", deployment_environment=~\"$deployment_environment\", area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 4,
      "title": "Top endpoints by request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{service=\"keycloak\", deployment_environment=~\"$deployment_environment\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}"
        }
      ]
    }
  ]
}
