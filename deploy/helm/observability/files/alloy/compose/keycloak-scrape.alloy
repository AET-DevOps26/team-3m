prometheus.scrape "keycloak" {
  targets = [{
    "__address__"            = "keycloak:9000",
    "service"                = "keycloak",
    "deployment_environment" = "local",
  }]

  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}
