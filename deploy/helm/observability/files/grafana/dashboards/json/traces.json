{
  "uid": "kontor-traces",
  "title": "Kontor — Traces (Tempo)",
  "tags": ["kontor", "traces", "tempo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "deployment_environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total, deployment_environment)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total{deployment_environment=~\"$deployment_environment\"}, service)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service graph",
      "type": "nodeGraph",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "serviceMap" }
      ]
    },
    {
      "id": 2,
      "title": "Span latency p50 / p95 / p99 by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "p50",
          "expr": "histogram_quantile(0.50, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=~\"$deployment_environment\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50 {{service}}"
        },
        {
          "refId": "p95",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=~\"$deployment_environment\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95 {{service}}"
        },
        {
          "refId": "p99",
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=~\"$deployment_environment\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99 {{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Recent traces",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceqlSearch",
          "limit": 20,
          "tableType": "traces",
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "scope": "resource",
              "operator": "=~",
              "value": "$service",
              "valueType": "string"
            }
          ]
        }
      ]
    }
  ]
}
