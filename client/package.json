{
  "name": "kontor",
  "private": true,
  "version": "0.27.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postinstall": "vite-envs update-types",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --fix",
    "lint:fix-unsafe": "biome check . --fix --unsafe",
    "format": "biome format . --fix",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "generate:api": "openapi-ts && openapi-ts -f openapi-ts.ai.config.ts && biome check --write --no-errors-on-unmatched src/network/generated src/network/generated-ai",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.2.10",
    "@grafana/faro-react": "^2.7.1",
    "@grafana/faro-web-tracing": "^2.7.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-envs": "^4.6.2",
    "vitest": "^4.1.9"
  }
}
