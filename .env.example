POSTGRES_DB=team3m
POSTGRES_USER=team3m
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dedicated news service Postgres.
NEWS_POSTGRES_DB=news
NEWS_POSTGRES_USER=news
NEWS_POSTGRES_PASSWORD=change-me-news-local
NEWS_POSTGRES_PORT=5434

# RabbitMQ (news aggregator publishes crawled articles; management UI on :15672)
RABBITMQ_USER=news
RABBITMQ_PASSWORD=change-me-rabbit-local
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_MGMT_PORT=9000
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=change-me-local
KEYCLOAK_DEV_USERS_PASSWORD=dev
KEYCLOAK_AUDIENCE=kontor-api

# Dedicated AI service Postgres (recommendation history).
AI_POSTGRES_DB=kontor_ai
AI_POSTGRES_USER=kontor_ai
AI_POSTGRES_PASSWORD=change-me-local
AI_POSTGRES_PORT=5433

# Twelve Data API key for live stock/ETF market data (quotes, price history, the
# holdings chart). Get a free key at https://twelvedata.com/pricing (the free tier
# is enough for local testing). When empty, market-data calls return 502 with a
# message explaining the key is missing instead of live prices — the rest of the
# app still works.
TWELVE_DATA_API_KEY=

# Logos AI API key (lg-… key from your tutor; requires TUM network / eduVPN) and
# embedding model. Both power hosted news ingest; the model must support the
# OpenAI-compatible /embeddings endpoint.
LOGOS_API_KEY=
LOGOS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Local LLM fallback. Used automatically when LOGOS_API_KEY is empty (e.g. off the TUM
# network). Defaults target Ollama. NOTE: in fallback mode your portfolio data is sent to
# whatever listens on LOCAL_LLM_BASE_URL (by default a local Ollama on this host). Set
# LOCAL_LLM_BASE_URL= (empty) to disable the fallback entirely — recommendation calls then
# return 503 instead of using a local model. See the README "Local LLM" section.
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=llama3.2
# LOCAL_EMBEDDING_MODEL=nomic-embed-text
